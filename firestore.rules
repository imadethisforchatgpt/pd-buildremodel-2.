rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function smallDocument() { return request.resource.size < 1048576; }
    function allowedCollection(name) {
      return name in ['clients','projects','estimates','invoices','payments','settings'];
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['createdAt','displayName']);
      allow update: if owner(uid) && request.resource.data.keys().hasOnly(['createdAt','displayName']);
      allow delete: if false;
      match /{collection}/{docId} {
        allow read: if owner(uid) && allowedCollection(collection);
        allow create, update: if owner(uid) && allowedCollection(collection)
          && smallDocument() && request.resource.data.keys().hasAll(['updatedAt']);
        allow delete: if owner(uid) && allowedCollection(collection);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}