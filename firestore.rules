rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validSnapshot() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion','revision','payload','mutationId','updatedAt'])
        && d.keys().hasAll(['schemaVersion','revision','payload','mutationId','updatedAt'])
        && d.schemaVersion == 1 && d.revision is int
        && d.payload is string && d.payload.size() <= 700000
        && d.mutationId is string && d.mutationId.size() >= 10 && d.mutationId.size() <= 100
        && d.updatedAt is timestamp && d.updatedAt == request.time;
    }
    // Atomic workspace contains all record types; the adapter excludes photo bytes.
    match /users/{uid}/settings/workspace-v1 {
      allow read: if owner(uid);
      allow create: if owner(uid) && validSnapshot() && request.resource.data.revision == 1;
      allow update: if owner(uid) && validSnapshot()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
